<?xml version="1.0" encoding="utf-8"?>
<!--
  Same identity as packaging/AppxManifest.template.xml.
  Name InControl.App and Version 2.0.0.0 are what Partner Center will accept
  after the 1.4.0 upload. Publisher is the account publisher
  CN=5305D976-6952-4F00-9C21-3A5DB090359F.
  Application Id is not the package identity. It cannot contain a dot.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="InControl.App"
    Publisher="CN=5305D976-6952-4F00-9C21-3A5DB090359F"
    Version="2.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>InControl</DisplayName>
    <PublisherDisplayName>InControl</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Ollama chat for Windows, on this PC or over SSH to a GPU you rented.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="InControlDesktop"
      Executable="InControl.App.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="InControl"
        Description="Ollama chat for Windows, on this PC or over SSH to a GPU you rented"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
