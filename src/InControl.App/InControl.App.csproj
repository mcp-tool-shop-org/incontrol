<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Without this the package MinVersion becomes the SDK version, 22621, and Windows 10 cannot install it. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <RootNamespace>InControl.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>InControl - Ollama chat for Windows, on this PC or over SSH to a GPU you rented</Description>

    <!-- Store package is 2.0.1.0. The Store already has mcp-tool-shop.InControl-Desktop 1.4.0.0. -->
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <InformationalVersion>2.0.1</InformationalVersion>
  </PropertyGroup>

  <!-- Debug: Unpackaged deployment (framework-dependent for faster dev iteration) -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Disable PRI/MRT resource generation for CLI builds -->
    <GeneratePriFileDuringBuild>false</GeneratePriFileDuringBuild>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <MrtCoreGenerateBundlePri>false</MrtCoreGenerateBundlePri>
    <DisableMrtResourceGeneration>true</DisableMrtResourceGeneration>
    <DisableMsixProjectCapabilityAddedByProject>true</DisableMsixProjectCapabilityAddedByProject>
  </PropertyGroup>

  <!-- Release: MSIX packaged deployment with self-contained runtime for Store compatibility -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <!-- Leave the fourth part at 0. A build must not walk 2.0.1.0 forward on its own. -->
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>..\..\AppPackages\</AppxPackageDir>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- A portable build (WindowsPackageType=None) has no package manifest. -->
  <ItemGroup Condition="'$(Configuration)'=='Release' and '$(WindowsPackageType)'!='None'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InControl.Core\InControl.Core.csproj" />
    <ProjectReference Include="..\InControl.Inference\InControl.Inference.csproj" />
    <ProjectReference Include="..\InControl.Services\InControl.Services.csproj" />
    <ProjectReference Include="..\InControl.ViewModels\InControl.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="KokoroSharp" GeneratePathProperty="true" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- KokoroSharp copies its voices and eSpeak data with an after-build Copy, which never reaches publish or the MSIX. -->
  <ItemGroup Condition="'$(PkgKokoroSharp)' != ''">
    <!-- The package is x64 Windows. The Linux, macOS and Arm64 eSpeak libraries stay out. -->
    <Content Include="$(PkgKokoroSharp)\content\**\*" Exclude="$(PkgKokoroSharp)\content\espeak\espeak-ng-linux-*;$(PkgKokoroSharp)\content\espeak\espeak-ng-macos-*;$(PkgKokoroSharp)\content\espeak\espeak-ng-win-arm64*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Skip MRT output groups in Debug CLI builds (they require VS tooling) -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <ComputeAllOutputGroupsDependsOn></ComputeAllOutputGroupsDependsOn>
    <AllOutputGroupsDependsOn></AllOutputGroupsDependsOn>
  </PropertyGroup>

</Project>
